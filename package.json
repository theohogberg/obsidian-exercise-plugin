{
	"name": "gym-plugin",
	"version": "0.4.0",
	"description": "Build workout programmes, log sets with last time's weights prefilled, and save sessions as notes.",
	"private": true,
	"author": "theohog",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/theohogberg/obsidian-exercise-plugin.git"
	},
	"license": "0-BSD",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node scripts/build-exercises.mjs --check && tsc && node esbuild.config.mjs production",
		"test": "tsc -p tests && vitest run",
		"exercises": "node scripts/build-exercises.mjs",
		"prepare": "git config core.hooksPath .githooks || true",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"gym",
		"workout"
	],
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^24.19.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.5",
		"jiti": "^2.7.0",
		"moment": "^2.31.0",
		"obsidian": "^1.13.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3"
	}
}
